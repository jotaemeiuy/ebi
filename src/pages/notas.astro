---
import Layout from "../layouts/Layout.astro";
import datos from "../data/notas-escritos.json";

// Si una cédula aparece en más de un grupo, se muestra solo el último (9C).
const indice: Record<
	string,
	{
		ci: string;
		nombre: string;
		grupo: string;
		escritos: Record<string, { nota: number; obs: string }>;
		temas: Record<string, string>;
	}
> = {};

for (const [grupo, info] of Object.entries(datos)) {
	for (const alumno of info.alumnos) {
		indice[alumno.ci] = {
			ci: alumno.ci,
			nombre: alumno.nombre,
			grupo,
			escritos: alumno.escritos,
			temas: info.temas,
		};
	}
}

const datosCliente = JSON.stringify({ alumnos: indice });
---

<Layout
	title="Consulta de escritos | EBI Arroyo Seco"
	description="Consultá tus notas de escritos de Matemática con tu cédula de identidad."
	noindex
>
	<section class="relative overflow-hidden py-16 sm:py-20">
		<div
			class="absolute inset-0 bg-linear-to-b from-violet-900/20 via-slate-950 to-slate-950"
		>
		</div>
		<div
			class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-violet-600/10 rounded-full blur-3xl"
		>
		</div>

		<div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<span
					class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-sm font-medium mb-6"
				>
					<span class="w-2 h-2 rounded-full bg-violet-400"></span>
					Matemática · 9° EBI
				</span>
				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
					Consulta de <span class="text-violet-400">escritos</span>
				</h1>
				<p class="text-slate-400 max-w-xl mx-auto">
					Ingresá tu cédula de identidad <strong class="text-slate-300"
						>sin puntos ni guion</strong
					> para ver tus notas de los escritos.
				</p>
			</div>

			<div
				class="rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur p-6 sm:p-8 shadow-xl shadow-violet-950/20"
			>
				<form id="form-cedula" novalidate>
					<label
						for="cedula"
						class="block text-sm font-medium text-slate-300 mb-2"
						>Cédula de identidad</label
					>
					<div class="flex flex-col sm:flex-row gap-3">
						<input
							id="cedula"
							name="cedula"
							type="text"
							inputmode="numeric"
							autocomplete="off"
							placeholder="Ej: 58687676"
							class="flex-1 rounded-lg border border-slate-700 bg-slate-950/70 px-4 py-3 text-lg tracking-wider text-slate-100 placeholder:text-slate-600 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/40"
						/>
						<button
							type="submit"
							class="inline-flex items-center justify-center gap-2 rounded-lg bg-violet-600 px-6 py-3 font-medium text-white transition-colors hover:bg-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/60"
						>
							Ver mis escritos
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="w-5 h-5"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"
								></path>
							</svg>
						</button>
					</div>
					<p
						id="error-cedula"
						class="hidden mt-3 text-sm text-red-400"
						role="alert"
						aria-live="polite"
					>
					</p>
				</form>
			</div>

			<div id="resultado" class="hidden mt-8" aria-live="polite">
				<div
					class="rounded-2xl border border-slate-800 bg-slate-900/60 backdrop-blur overflow-hidden"
				>
					<div
						class="flex flex-wrap items-center gap-4 border-b border-slate-800 px-6 py-5"
					>
						<div
							id="avatar"
							class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-violet-600/20 text-lg font-semibold text-violet-300"
						>
						</div>
						<div class="min-w-0 flex-1">
							<p id="nombre-alumno" class="truncate text-lg font-semibold"></p>
							<p class="text-sm text-slate-400">
								<span
									id="grupo-alumno"
									class="inline-flex items-center rounded-full bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-slate-300"
								></span>
								<span id="resumen" class="ml-2"></span>
							</p>
						</div>
					</div>

					<ul id="lista-escritos" class="divide-y divide-slate-800"></ul>
				</div>
			</div>
		</div>
	</section>

	<script type="application/json" id="datos-notas" set:html={datosCliente} />

	<script>
		type Escrito = { nota: number; obs: string };
		type Alumno = {
			ci: string;
			nombre: string;
			grupo: string;
			escritos: Record<string, Escrito>;
			temas: Record<string, string>;
		};

		const datos: { alumnos: Record<string, Alumno> } = JSON.parse(
			document.getElementById("datos-notas")!.textContent || "{}",
		);

		const form = document.getElementById("form-cedula") as HTMLFormElement;
		const input = document.getElementById("cedula") as HTMLInputElement;
		const errorCedula = document.getElementById("error-cedula")!;
		const resultado = document.getElementById("resultado")!;
		const avatar = document.getElementById("avatar")!;
		const nombreAlumno = document.getElementById("nombre-alumno")!;
		const grupoAlumno = document.getElementById("grupo-alumno")!;
		const resumen = document.getElementById("resumen")!;
		const lista = document.getElementById("lista-escritos")!;

		const OBS_ESPECIALES: Record<string, string> = {
			"no asisitio": "No asistió",
			"no asisitió": "No asistió",
			"entrego en blanco": "Entrega en blanco",
		};

		/** Comentario legible para un escrito con nota 1. */
		function textoEntrega(escrito: Escrito): string {
			const obs = escrito.obs.trim().replace(/\.$/, "");
			if (!obs) return "Entrega en blanco";
			const normalizada = OBS_ESPECIALES[obs.toLowerCase()];
			if (normalizada) return normalizada;
			return obs.charAt(0).toUpperCase() + obs.slice(1);
		}

		function formatearNombre(nombre: string): string {
			const [apellidos, nombres] = nombre.split(",").map((p) => p.trim());
			const capitalizar = (texto: string) =>
				texto
					.toLowerCase()
					.split(/\s+/)
					.map((palabra) => palabra.charAt(0).toUpperCase() + palabra.slice(1))
					.join(" ");
			return nombres ? `${capitalizar(nombres)} ${capitalizar(apellidos)}` : capitalizar(nombre);
		}

		function iniciales(nombre: string): string {
			const [apellidos = "", nombres = ""] = nombre.split(",");
			return (
				(nombres.trim().charAt(0) || "") + (apellidos.trim().charAt(0) || "")
			).toUpperCase();
		}

		function mostrarError(mensaje: string) {
			errorCedula.textContent = mensaje;
			errorCedula.classList.remove("hidden");
			resultado.classList.add("hidden");
			input.setAttribute("aria-invalid", "true");
			input.focus();
		}

		function limpiarError() {
			errorCedula.classList.add("hidden");
			errorCedula.textContent = "";
			input.removeAttribute("aria-invalid");
		}

		function crearFila(fecha: string, tema: string, escrito: Escrito) {
			const aprobado = escrito.nota >= 5;
			const esEntrega = escrito.nota === 1;

			const item = document.createElement("li");
			item.className =
				"flex flex-col gap-2 px-6 py-4 sm:flex-row sm:items-center sm:gap-4";

			const fechaEl = document.createElement("span");
			fechaEl.className =
				"inline-flex w-fit shrink-0 items-center gap-1.5 rounded-full border border-slate-700 bg-slate-800/60 px-3 py-1 text-xs font-medium text-slate-300";
			fechaEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M4 11h16M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`;
			fechaEl.append(document.createTextNode(fecha));

			const temaEl = document.createElement("span");
			temaEl.className = "flex-1 text-sm text-slate-200 sm:text-base";
			temaEl.textContent = tema;

			const notaEl = document.createElement("span");
			notaEl.className = aprobado
				? "inline-flex w-fit shrink-0 items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-sm font-semibold text-emerald-300"
				: "inline-flex w-fit shrink-0 items-center rounded-full border border-red-500/30 bg-red-500/10 px-3 py-1 text-sm font-semibold text-red-400";
			notaEl.textContent = esEntrega ? textoEntrega(escrito) : String(escrito.nota);

			item.append(fechaEl, temaEl, notaEl);
			return item;
		}

		function mostrarAlumno(alumno: Alumno) {
			const fechas = Object.keys(alumno.escritos).sort((a, b) => {
				const clave = (f: string) => {
					const [dia, mes] = f.split("/").map(Number);
					return (mes < 3 ? mes + 12 : mes) * 100 + dia;
				};
				return clave(a) - clave(b);
			});

			avatar.textContent = iniciales(alumno.nombre);
			nombreAlumno.textContent = formatearNombre(alumno.nombre);
			grupoAlumno.textContent = `Grupo ${alumno.grupo}`;
			resumen.textContent = `${fechas.length} de ${Object.keys(alumno.temas).length} escritos registrados`;

			lista.replaceChildren();
			for (const fecha of fechas) {
				const escrito = alumno.escritos[fecha];
				lista.append(
					crearFila(fecha, alumno.temas[fecha] ?? "Escrito", escrito),
				);
			}

			resultado.classList.remove("hidden");
			resultado.scrollIntoView({ behavior: "smooth", block: "nearest" });
		}

		form.addEventListener("submit", (evento) => {
			evento.preventDefault();
			limpiarError();

			const cedula = input.value.replace(/\D/g, "");

			if (!cedula) {
				mostrarError("Ingresá tu cédula sin puntos ni guion (solo números).");
				return;
			}
			if (cedula.length !== 7 && cedula.length !== 8) {
				mostrarError("La cédula debe tener 7 u 8 números, sin puntos ni guion.");
				return;
			}

			const alumno = datos.alumnos[cedula];
			if (!alumno) {
				mostrarError(
					"No encontramos esa cédula. Verificá que esté bien escrita y sin guion.",
				);
				return;
			}

			if (!Object.keys(alumno.escritos).length) {
				mostrarError(
					"Encontramos tu cédula, pero todavía no hay escritos registrados para vos.",
				);
				return;
			}

			mostrarAlumno(alumno);
		});

		input.addEventListener("input", () => {
			input.value = input.value.replace(/[^\d.\-\s]/g, "");
			limpiarError();
		});
	</script>
</Layout>
