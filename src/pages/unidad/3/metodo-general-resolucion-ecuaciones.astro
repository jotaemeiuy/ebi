    font-size: 1.22rem;
    padding: 0.55rem 0.9rem;
    margin: 0.8rem 0;
  }
  .formula::-webkit-scrollbar {
    height: 6px;
  }
  .formula::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 3px;
  }
  @media (max-width: 640px) {
    .formula {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
    }
    .formula-lg {
      font-size: 0.9rem;
    }
    li .katex {
      font-size: 0.88em;
    }
  }
</style>

      <div class="practico-box mt-10">
        <h3>¿Querés practicar?</h3>
        <p>Descargá los ejercicios de método general de resolución.</p>
