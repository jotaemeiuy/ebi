    border-radius: 6px;
    padding: 0.35rem 0.9rem;
    margin: 0.55rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .formula .katex-display {
    margin: 0.25em 0;
  }
  .formula-lg {
    font-size: 1.22rem;
    padding: 0.55rem 0.9rem;
    margin: 0.8rem 0;
  }
  .formula::-webkit-scrollbar {
    height: 6px;
  }
  .formula::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 3px;
  }
  @media (max-width: 640px) {
    .formula {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
    }
    .formula-lg {
      font-size: 0.9rem;
    }
    li .katex {
      font-size: 0.88em;
    }
  }
</style>

      <div class="practico-box mt-10">
        <h3>¿Querés practicar?</h3>
        <p>Descargá los ejercicios de ecuaciones equivalentes.</p>
        <a href="/pdfs/3-4-ecuaciones-equivalentes.pdf" target="_blank" rel="noopener">
          Descargar práctico (PDF)
        </a>
      </div>

</Leccion>
