---
import Leccion from "../../../layouts/Leccion.astro";

function fmt(n) {
  const r = Math.round(n * 100) / 100;
  return String(r).replace("-", "−");
}

function quadLabel(a, b, c) {
  let s = "f(x) = ";
  s += (a === 1 ? "" : a === -1 ? "−" : fmt(a)) + "x²";
  if (b !== 0) s += (b > 0 ? " + " : " − ") + (Math.abs(b) === 1 ? "" : fmt(Math.abs(b))) + "x";
  if (c !== 0) s += (c > 0 ? " + " : " − ") + fmt(Math.abs(c));
  return s;
}

function graphSvg(o) {
  const w = o.w || 460;
  const h = o.h || 380;
  const pl = 40, pr = 20, pt = 42, pb = 34;
  const { xmin, xmax, ymin, ymax, a, b, c } = o;
  const sx = (w - pl - pr) / (xmax - xmin);
  const sy = (h - pt - pb) / (ymax - ymin);
  const px = (x) => pl + (x - xmin) * sx;
  const py = (y) => pt + (ymax - y) * sy;
  const parts = [];
  const uid = o.uid || "g";

  parts.push(
    `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${o.aria || quadLabel(a, b, c)}" style="display:block;width:100%;height:auto">`
  );

  // Cuadrícula
  parts.push('<g stroke="#1e293b" stroke-width="1">');
  for (let x = Math.ceil(xmin); x <= Math.floor(xmax); x++) {
    parts.push(`<line x1="${px(x).toFixed(1)}" y1="${py(ymin).toFixed(1)}" x2="${px(x).toFixed(1)}" y2="${py(ymax).toFixed(1)}"/>`);
  }
  for (let y = Math.ceil(ymin); y <= Math.floor(ymax); y++) {
    parts.push(`<line x1="${px(xmin).toFixed(1)}" y1="${py(y).toFixed(1)}" x2="${px(xmax).toFixed(1)}" y2="${py(y).toFixed(1)}"/>`);
  }
  parts.push("</g>");

  // Ejes
  parts.push(`<defs><marker id="arr-${uid}" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M 0 0 L 9 4.5 L 0 9 z" fill="#94a3b8"/></marker></defs>`);
  if (ymin < 0 && ymax > 0) {
    parts.push(`<line x1="${px(xmin).toFixed(1)}" y1="${py(0).toFixed(1)}" x2="${(px(xmax) + 8).toFixed(1)}" y2="${py(0).toFixed(1)}" stroke="#94a3b8" stroke-width="1.8" marker-end="url(#arr-${uid})"/>`);
    parts.push(`<text x="${(px(xmax) + 2).toFixed(1)}" y="${(py(0) + 17).toFixed(1)}" fill="#94a3b8" font-size="12">x</text>`);
  }
  if (xmin < 0 && xmax > 0) {
    parts.push(`<line x1="${px(0).toFixed(1)}" y1="${py(ymin).toFixed(1)}" x2="${px(0).toFixed(1)}" y2="${(py(ymax) - 8).toFixed(1)}" stroke="#94a3b8" stroke-width="1.8" marker-end="url(#arr-${uid})"/>`);
    parts.push(`<text x="${(px(0) + 7).toFixed(1)}" y="${(py(ymax) + 14).toFixed(1)}" fill="#94a3b8" font-size="12">y</text>`);
  }

  // Raíces (se calculan antes para no repetir números en el eje x)
  const disc = b * b - 4 * a * c;
  const rootVals = [];
  if (disc >= 0) {
    const r1 = (-b - Math.sqrt(disc)) / (2 * a);
    const r2 = (-b + Math.sqrt(disc)) / (2 * a);
    if (disc === 0) rootVals.push(r1);
    else rootVals.push(Math.min(r1, r2), Math.max(r1, r2));
  }

  // Números en los ejes
  const stepX = xmax - xmin > 9 ? 2 : 1;
  const stepY = ymax - ymin > 9 ? 2 : 1;
  parts.push('<g fill="#64748b" font-size="10" text-anchor="middle">');
  if (ymin < 0 && ymax > 0) {
    for (let x = Math.ceil(xmin / stepX) * stepX; x <= xmax; x += stepX) {
      if (x === 0) continue;
      if (rootVals.some((r) => Math.abs(r - x) < 0.4)) continue;
      parts.push(`<text x="${px(x).toFixed(1)}" y="${(py(0) + 14).toFixed(1)}">${fmt(x)}</text>`);
    }
  }
  if (xmin < 0 && xmax > 0) {
    for (let y = Math.ceil(ymin / stepY) * stepY; y <= ymax; y += stepY) {
      if (y === 0) continue;
      parts.push(`<text x="${(px(0) - 6).toFixed(1)}" y="${(py(y) + 3).toFixed(1)}" text-anchor="end">${fmt(y)}</text>`);
    }
  }
  parts.push("</g>");

  // Parábola
  let d = "";
  for (let i = 0; i <= 320; i++) {
    const x = xmin + ((xmax - xmin) * i) / 320;
    const y = a * x * x + b * x + c;
    d += (i === 0 ? "M" : " L") + px(x).toFixed(1) + " " + py(y).toFixed(1);
  }
  parts.push(`<path d="${d}" fill="none" stroke="#a78bfa" stroke-width="3" stroke-linecap="round"/>`);

  // Eje de simetría
  const xv = -b / (2 * a);
  const yv = a * xv * xv + b * xv + c;
  if (o.axis && xv > xmin && xv < xmax) {
    parts.push(`<line x1="${px(xv).toFixed(1)}" y1="${py(ymin).toFixed(1)}" x2="${px(xv).toFixed(1)}" y2="${py(ymax).toFixed(1)}" stroke="#f472b6" stroke-width="1.6" stroke-dasharray="6 5" opacity="0.75"/>`);
    parts.push(`<text x="${(px(xv) + 6).toFixed(1)}" y="${(py(ymax) + 12).toFixed(1)}" fill="#f472b6" font-size="11" stroke="#0b1120" stroke-width="3" paint-order="stroke">x = ${fmt(xv)}</text>`);
  }

  // Raíces
  if (o.roots !== false && disc >= 0) {
    const roots = disc === 0 ? [rootVals[0]] : rootVals;
    roots.forEach((r, i) => {
      if (r < xmin || r > xmax) return;
      parts.push(`<circle cx="${px(r).toFixed(1)}" cy="${py(0).toFixed(1)}" r="5.5" fill="#f59e0b"/>`);
      const label = disc === 0 ? `x = ${fmt(r)}` : `x${i === 0 ? "₁" : "₂"} = ${fmt(r)}`;
      parts.push(`<text x="${px(r).toFixed(1)}" y="${(py(0) + 18).toFixed(1)}" text-anchor="middle" fill="#f59e0b" font-size="11" stroke="#0b1120" stroke-width="3" paint-order="stroke">${label}</text>`);
    });
  }

  // Ordenada en el origen
  if (o.intercept !== false && c >= ymin && c <= ymax) {
    parts.push(`<circle cx="${px(0).toFixed(1)}" cy="${py(c).toFixed(1)}" r="5" fill="#34d399"/>`);
    parts.push(`<text x="${(px(0) + 9).toFixed(1)}" y="${(py(c) + 4).toFixed(1)}" fill="#34d399" font-size="11" stroke="#0b1120" stroke-width="3" paint-order="stroke">(0, ${fmt(c)})</text>`);
  }

  // Vértice
  if (o.vertex) {
    parts.push(`<circle cx="${px(xv).toFixed(1)}" cy="${py(yv).toFixed(1)}" r="5.5" fill="#f472b6"/>`);
    const dy = a > 0 ? 18 : -8;
    parts.push(`<text x="${(px(xv) + 9).toFixed(1)}" y="${(py(yv) + dy).toFixed(1)}" fill="#f472b6" font-size="11" stroke="#0b1120" stroke-width="3" paint-order="stroke">V (${fmt(xv)}, ${fmt(yv)})</text>`);
  }

  // Puntos de la tabla
  if (o.points) {
    o.points.forEach(([x, y]) => {
      if (y < ymin || y > ymax) return;
      parts.push(`<circle cx="${px(x).toFixed(1)}" cy="${py(y).toFixed(1)}" r="4" fill="#c4b5fd"/>`);
    });
  }

  // Nombre de la función
  parts.push(`<text x="${pl + 2}" y="22" fill="#a78bfa" font-size="12" font-family="ui-monospace, monospace">${quadLabel(a, b, c)}</text>`);

  parts.push("</svg>");
  return parts.join("");
}

function signLine(kind, roots, note) {
  const w = 380, h = 112;
  const y = 58, left = 30, right = 342;
  const rs = (roots || []).slice().sort((a, b) => a - b);
  const span = rs.length ? rs[rs.length - 1] - rs[0] : 0;
  const pad = span > 0 ? span * 0.55 : 2.2;
  const dmin = rs.length ? rs[0] - pad : -2.5;
  const dmax = rs.length ? rs[rs.length - 1] + pad : 2.5;
  const px = (x) => left + ((x - dmin) / (dmax - dmin)) * (right - left);

  const P = { t: "+", c: "#34d399" };
  const M = { t: "−", c: "#f87171" };
  const Z = { t: "0", c: "#f59e0b" };
  const signs = [];

  if (kind === "pos-out" || kind === "neg-out") {
    const [r1, r2] = rs;
    const outside = kind === "pos-out" ? P : M;
    const inside = kind === "pos-out" ? M : P;
    signs.push({ x: dmin + (r1 - dmin) * 0.5, ...outside });
    signs.push({ x: r1, ...Z, root: true });
    signs.push({ x: (r1 + r2) / 2, ...inside });
    signs.push({ x: r2, ...Z, root: true });
    signs.push({ x: r2 + (dmax - r2) * 0.5, ...outside });
  } else if (kind === "double-pos" || kind === "double-neg") {
    const [r] = rs;
    const c = kind === "double-pos" ? P : M;
    signs.push({ x: dmin + (r - dmin) * 0.5, ...c });
    signs.push({ x: r, ...Z, root: true });
    signs.push({ x: r + (dmax - r) * 0.5, ...c });
  } else {
    const c = kind === "always-pos" ? P : M;
    [0.2, 0.5, 0.8].forEach((f) => signs.push({ x: dmin + (dmax - dmin) * f, ...c }));
  }

  const parts = [];
  parts.push(`<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Esquema de signos sobre la recta numérica" style="display:block;width:100%;max-width:380px;margin:.35rem auto 0">`);
  parts.push(`<line x1="${left}" y1="${y}" x2="${right + 10}" y2="${y}" stroke="#94a3b8" stroke-width="1.8"/>`);
  parts.push(`<path d="M ${right + 19} ${y} l -10 -5 v 10 z" fill="#94a3b8"/>`);
  parts.push(`<text x="${right + 12}" y="${y - 9}" fill="#94a3b8" font-size="11">x</text>`);
  signs.forEach((s) => {
    const sx = px(s.x).toFixed(1);
    if (s.root) {
      parts.push(`<line x1="${sx}" y1="${y - 6}" x2="${sx}" y2="${y + 6}" stroke="#f59e0b" stroke-width="2.5"/>`);
      parts.push(`<text x="${sx}" y="${y + 24}" text-anchor="middle" fill="#f59e0b" font-size="12" font-family="ui-monospace, monospace">${fmt(s.x)}</text>`);
    }
    parts.push(`<text x="${sx}" y="${y - 12}" text-anchor="middle" fill="${s.c}" font-size="21" font-weight="700" font-family="ui-monospace, monospace">${s.t}</text>`);
  });
  parts.push("</svg>");
  if (note) {
    parts.push(`<div style="text-align:center;color:#94a3b8;font-size:.72rem;margin-top:.15rem">${note}</div>`);
  }
  return parts.join("");
}
---

<Leccion title="Función cuadrática - Teoría" unitId={7} unitTitle="Función cuadrática">

<div class="lesson-box">
  <h2>Contenido de esta lección:</h2>
  <ul>
    <li><a href="#que-es">• 1. ¿Qué es una función cuadrática?</a></li>
    <li><a href="#lugar">• 2. La parábola como lugar geométrico</a></li>
    <li><a href="#hilo">• 3. Construcción con hilo (interactivo)</a></li>
    <li><a href="#tabla">• 4. Tabla, imagen y preimagen</a></li>
    <li><a href="#raices">• 5. Raíces: los tres casos</a></li>
    <li><a href="#vertice">• 6. Vértice y eje de simetría</a></li>
    <li><a href="#signo">• 7. Signo de las imágenes</a></li>
    <li><a href="#resumen">• 8. Resumen</a></li>
  </ul>
</div>

<div id="que-es" class="lesson-box">
  <h2>1. ¿Qué es una función cuadrática?</h2>
  <p>
    Una <strong>función cuadrática</strong> es una función cuya fórmula se puede
    escribir así:
  </p>
  <p class="font-mono text-violet-400" style="font-size:1.25rem">f(x) = ax² + bx + c, con a ≠ 0</p>
  <p>
    Los números <strong>a</strong>, <strong>b</strong> y <strong>c</strong> son
    fijos: <strong>a</strong> es el coeficiente principal, <strong>b</strong> el
    coeficiente lineal y <strong>c</strong> el término independiente. La
    condición <span class="font-mono text-violet-400">a ≠ 0</span> es la que
    hace que la función sea cuadrática.
  </p>
  <p>
    Su gráfica es una curva llamada <strong>parábola</strong>. En la función
    lineal la gráfica era una recta; acá aparece una curva.
  </p>

  <table>
    <thead>
      <tr><th>Función</th><th>a</th><th>b</th><th>c</th><th>¿Abre hacia…?</th></tr>
    </thead>
    <tbody>
      <tr><td>f(x) = x²</td><td>1</td><td>0</td><td>0</td><td>arriba</td></tr>
      <tr><td>f(x) = x² − 2x − 3</td><td>1</td><td>−2</td><td>−3</td><td>arriba</td></tr>
      <tr><td>f(x) = −2x² + 8x − 5</td><td>−2</td><td>8</td><td>−5</td><td>abajo</td></tr>
    </tbody>
  </table>

  <p>
    El signo de <strong>a</strong> decide la apertura de la parábola:
  </p>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li>Si <span class="font-mono text-violet-400">a &gt; 0</span>, la parábola se abre hacia <strong>arriba</strong> (como una sonrisa).</li>
    <li>Si <span class="font-mono text-violet-400">a &lt; 0</span>, la parábola se abre hacia <strong>abajo</strong>.</li>
    <li>Cuanto más grande es <span class="font-mono text-violet-400">|a|</span>, más <strong>angosta</strong> es la parábola.</li>
  </ul>
</div>

<div id="lugar" class="lesson-box">
  <h2>2. La parábola como lugar geométrico</h2>
  <p>
    Una <strong>parábola</strong> es el <strong>lugar geométrico</strong> de los
    puntos del plano que <strong>equidistan</strong> de un punto fijo llamado
    <strong>foco</strong> y de una recta fija llamada <strong>directriz</strong>.
  </p>
  <p>
    Es decir: si <strong>P</strong> es un punto de la parábola, entonces la
    distancia de <strong>P</strong> al foco <strong>F</strong> es igual a la
    distancia de <strong>P</strong> a la directriz.
  </p>

  <svg viewBox="0 0 520 340" role="img" aria-label="Parábola como lugar geométrico: el punto P equidista del foco F y de la directriz" style="display:block;margin:1.5rem auto;max-width:560px;width:100%">
    <defs>
      <marker id="lugar-flecha" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
        <path d="M 0 0 L 9 4.5 L 0 9 z" fill="#94a3b8"/>
      </marker>
    </defs>

    <!-- Parábola -->
    <path d="M 180 182.2 L 200 190 L 220 195.6 L 240 198.9 L 260 200 L 280 198.9 L 300 195.6 L 320 190 L 340 182.2" fill="none" stroke="#a78bfa" stroke-width="3"/>

    <!-- Directriz -->
    <line x1="40" y1="290" x2="480" y2="290" stroke="#f472b6" stroke-width="2" stroke-dasharray="7 5"/>
    <text x="476" y="310" text-anchor="end" fill="#f472b6" font-size="12">directriz</text>

    <!-- Eje de simetría -->
    <line x1="260" y1="40" x2="260" y2="290" stroke="#475569" stroke-width="1" stroke-dasharray="4 5"/>

    <!-- Segmentos PF y PA -->
    <line x1="260" y1="110" x2="340" y2="182.2" stroke="#34d399" stroke-width="2.5"/>
    <line x1="340" y1="182.2" x2="340" y2="290" stroke="#34d399" stroke-width="2.5"/>

    <!-- Marcas de igualdad -->
    <line x1="296" y1="141" x2="304" y2="150" stroke="#34d399" stroke-width="2"/>
    <line x1="334" y1="233" x2="346" y2="233" stroke="#34d399" stroke-width="2"/>

    <!-- Puntos -->
    <circle cx="260" cy="110" r="6" fill="#fbbf24"/>
    <circle cx="340" cy="182.2" r="6" fill="#34d399"/>
    <circle cx="340" cy="290" r="5.5" fill="#f472b6"/>

    <!-- Etiquetas -->
    <text x="248" y="102" text-anchor="end" fill="#fbbf24" font-size="13">Foco F</text>
    <text x="350" y="176" fill="#34d399" font-size="13">P</text>
    <text x="350" y="308" fill="#f472b6" font-size="13">A</text>
    <text x="285" y="232" fill="#34d399" font-size="13" font-family="ui-monospace, monospace">PF = PA</text>
    <text x="270" y="55" fill="#64748b" font-size="11">eje de simetría</text>
    <text x="60" y="270" fill="#94a3b8" font-size="12">La distancia de P al foco es igual a la distancia de P a la directriz.</text>
  </svg>

  <p>
    El punto <strong>A</strong> es el pie de la perpendicular desde{" "}
    <strong>P</strong> a la directriz. Por eso el segmento <strong>PA</strong>{" "}
    mide la distancia de <strong>P</strong> a la directriz, y la definición dice
    que <span class="font-mono text-violet-400">PF = PA</span>.
  </p>
  <p>
    El punto de la parábola que está justo en el medio entre el foco y la
    directriz se llama <strong>vértice</strong>. La recta que pasa por el foco y
    el vértice es el <strong>eje de simetría</strong>.
  </p>
</div>

<div id="hilo" class="lesson-box">
  <h2>3. Construcción con hilo (interactivo)</h2>
  <p>
    La definición anterior permite <strong>dibujar la parábola con un hilo</strong>.
    Para cada punto <strong>A</strong> de la directriz:
  </p>
  <ol>
    <li>Trazamos la perpendicular a la directriz por <strong>A</strong>.</li>
    <li>Trazamos la mediatriz del segmento <strong>FA</strong>.</li>
    <li>Donde se cortan está <strong>P</strong>, un punto de la parábola.</li>
  </ol>
  <p>
    El hilo va del foco <strong>F</strong> al punto <strong>P</strong> y de{" "}
    <strong>P</strong> a <strong>A</strong>. Como <strong>P</strong> está en la
    mediatriz de <strong>FA</strong>, los dos tramos del hilo miden lo mismo:{" "}
    <span class="font-mono text-violet-400">PF = PA</span>. Al mover{" "}
    <strong>A</strong> por la directriz, el lápiz en <strong>P</strong> dibuja la
    parábola.
  </p>

  <div id="cuad-widget" style="background:rgba(15,23,42,0.6);border:1px solid #334155;border-radius:14px;padding:1rem;margin:1.5rem 0">
    <div style="display:flex;flex-wrap:wrap;gap:.75rem 1.25rem;align-items:center;margin-bottom:.75rem">
      <button id="cw-play" type="button" style="background:#7c3aed;color:#fff;border:0;border-radius:8px;padding:.5rem 1rem;font-weight:600;cursor:pointer">Pausar</button>
      <label style="color:#cbd5e1;font-size:.9rem">
        Distancia foco–directriz <strong style="color:#c4b5fd">p</strong>:{" "}
        <span id="cw-p-value" style="font-family:ui-monospace,monospace;color:#c4b5fd">1</span>{" "}
        <input id="cw-p" type="range" min="1" max="3" step="0.25" value="1" style="width:140px;accent-color:#8b5cf6;vertical-align:middle"/>
      </label>
      <label style="color:#cbd5e1;font-size:.9rem">
        Posición de <strong style="color:#f472b6">A</strong>:{" "}
        <input id="cw-t" type="range" min="-3.4" max="3.4" step="0.02" value="-3.4" style="width:140px;accent-color:#f472b6;vertical-align:middle"/>
      </label>
    </div>

    <div id="cw-scroll" style="overflow-x:auto;border-radius:10px;scrollbar-width:thin">
    <svg id="cw-svg" viewBox="0 0 640 440" role="img" aria-label="Construcción interactiva de la parábola con hilo: foco, directriz y punto P" style="display:block;width:100%;min-width:520px;height:auto;background:#0b1120;border-radius:10px">
      <defs>
        <marker id="cw-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
          <path d="M 0 0 L 9 4.5 L 0 9 z" fill="#94a3b8"/>
        </marker>
      </defs>
      <g id="cw-grid" stroke="#1e293b" stroke-width="1"></g>
      <line x1="16" y1="240" x2="632" y2="240" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#cw-arrow)"/>
      <line x1="320" y1="411" x2="320" y2="61" stroke="#94a3b8" stroke-width="1.6" marker-end="url(#cw-arrow)"/>
      <g id="cw-ticks" fill="#64748b" font-size="12" text-anchor="middle"></g>
      <text x="634" y="258" fill="#94a3b8" font-size="12">x</text>
      <text x="330" y="56" fill="#94a3b8" font-size="12">y</text>

      <path id="cw-parabola" fill="none" stroke="#a78bfa" stroke-width="3"/>
      <line id="cw-directrix" stroke="#f472b6" stroke-width="2" stroke-dasharray="7 5"/>
      <line id="cw-bisector" stroke="#f9a8d4" stroke-width="1.4" stroke-dasharray="5 4" opacity="0.8"/>
      <polyline id="cw-thread" fill="none" stroke="#34d399" stroke-width="2.5"/>

      <circle id="cw-focus" r="6" fill="#fbbf24"/>
      <circle id="cw-a" r="5.5" fill="#f472b6"/>
      <circle id="cw-p" r="6" fill="#34d399"/>

      <text id="cw-label-f" fill="#fbbf24" font-size="14" font-family="ui-monospace, monospace">F</text>
      <text id="cw-label-p" fill="#34d399" font-size="14" font-family="ui-monospace, monospace">P</text>
      <text id="cw-label-a" fill="#f472b6" font-size="14" font-family="ui-monospace, monospace">A</text>
      <text id="cw-label-d" fill="#f472b6" font-size="13" stroke="#0b1120" stroke-width="3" paint-order="stroke">directriz</text>
      <text x="320" y="26" text-anchor="middle" fill="#34d399" font-size="13" font-family="ui-monospace, monospace">Hilo: PF = PA</text>
    </svg>
    </div>

    <p id="cw-readout" style="margin:.75rem 0 0;font-family:ui-monospace,monospace;color:#94a3b8;font-size:.95rem"></p>
    <p style="margin:.35rem 0 0;color:#64748b;font-size:.85rem">
      El tramo verde es el hilo: siempre se cumple PF = PA. Mové el deslizador o
      usá «Pausar» para detener la animación.
    </p>
  </div>

  <script>
    (function () {
      function init() {
        var svg = document.getElementById("cw-svg");
        if (!svg) return;

        var NS = "http://www.w3.org/2000/svg";
        var ox = 320, oy = 240, step = 38;
        var p = 1, t = -3.4, dir = 1, last = performance.now();

        var pInput = document.getElementById("cw-p");
        var tInput = document.getElementById("cw-t");
        var pValue = document.getElementById("cw-p-value");
        var readout = document.getElementById("cw-readout");
        var playBtn = document.getElementById("cw-play");

        var parabola = document.getElementById("cw-parabola");
        var directrix = document.getElementById("cw-directrix");
        var bisector = document.getElementById("cw-bisector");
        var thread = document.getElementById("cw-thread");
        var focus = document.getElementById("cw-focus");
        var dotA = document.getElementById("cw-a");
        var dotP = document.getElementById("cw-p");
        var labelF = document.getElementById("cw-label-f");
        var labelP = document.getElementById("cw-label-p");
        var labelA = document.getElementById("cw-label-a");
        var labelD = document.getElementById("cw-label-d");

        var playing = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        playBtn.textContent = playing ? "Pausar" : "Reproducir";

        function px(x) { return ox + x * step; }
        function py(y) { return oy - y * step; }

        function el(name, attrs) {
          var e = document.createElementNS(NS, name);
          for (var k in attrs) e.setAttribute(k, attrs[k]);
          return e;
        }

        // Cuadrícula
        var grid = document.getElementById("cw-grid");
        for (var gx = -8; gx <= 8; gx++) {
          grid.appendChild(el("line", { x1: px(gx), y1: py(-4.5), x2: px(gx), y2: py(4.5) }));
        }
        for (var gy = -4; gy <= 4; gy++) {
          grid.appendChild(el("line", { x1: px(-8), y1: py(gy), x2: px(8), y2: py(gy) }));
        }

        // Números de los ejes
        var ticks = document.getElementById("cw-ticks");
        [-4, -2, 2, 4].forEach(function (x) {
          var tx = el("text", { x: px(x), y: py(0) + 15 });
          tx.textContent = String(x).replace("-", "−");
          ticks.appendChild(tx);
        });
        [-4, -2, 2, 4].forEach(function (y) {
          var ty = el("text", { x: px(0) - 8, y: py(y) + 4, "text-anchor": "end" });
          ty.textContent = String(y).replace("-", "−");
          ticks.appendChild(ty);
        });

        function update() {
          var yP = (t * t) / (4 * p);

          // Parábola
          var d = "";
          for (var i = 0; i <= 260; i++) {
            var x = -8 + (16 * i) / 260;
            var y = (x * x) / (4 * p);
            d += (i === 0 ? "M" : " L") + px(x).toFixed(1) + " " + py(y).toFixed(1);
          }
          parabola.setAttribute("d", d);

          // Directriz
          directrix.setAttribute("x1", px(-8));
          directrix.setAttribute("y1", py(-p));
          directrix.setAttribute("x2", px(8));
          directrix.setAttribute("y2", py(-p));

          // Puntos
          focus.setAttribute("cx", px(0));
          focus.setAttribute("cy", py(p));
          dotA.setAttribute("cx", px(t));
          dotA.setAttribute("cy", py(-p));
          dotP.setAttribute("cx", px(t));
          dotP.setAttribute("cy", py(yP));

          // Hilo F-P-A
          thread.setAttribute("points",
            px(0) + "," + py(p) + " " +
            px(t) + "," + py(yP) + " " +
            px(t) + "," + py(-p));

          // Mediatriz de FA
          var mx = t / 2, my = 0;
          var fx = t, fy = -2 * p;
          var len = Math.sqrt(fx * fx + fy * fy) || 1;
          var ux = -fy / len, uy = fx / len;
          bisector.setAttribute("x1", px(mx - ux * 4));
          bisector.setAttribute("y1", py(my - uy * 4));
          bisector.setAttribute("x2", px(mx + ux * 4));
          bisector.setAttribute("y2", py(my + uy * 4));

          // Etiquetas
          labelF.setAttribute("x", px(0) + 9);
          labelF.setAttribute("y", py(p) - 8);
          labelP.setAttribute("x", px(t) + 10);
          labelP.setAttribute("y", py(yP) - 6);
          labelA.setAttribute("x", px(t) + 10);
          labelA.setAttribute("y", py(-p) + 16);
          labelD.setAttribute("x", px(1.2) - 4);
          labelD.setAttribute("y", py(-p) - 9);

          var dist = Math.sqrt(t * t + Math.pow(yP - p, 2));
          readout.textContent =
            "P = (" + t.toFixed(2).replace(".", ",") + "; " + yP.toFixed(2).replace(".", ",") + ")" +
            "   ·   PF = PA = " + dist.toFixed(2).replace(".", ",");
        }

        function frame(now) {
          var dt = Math.min((now - last) / 1000, 0.05);
          last = now;
          if (playing) {
            t += dir * dt * 1.1;
            if (t > 3.4) { t = 3.4; dir = -1; }
            if (t < -3.4) { t = -3.4; dir = 1; }
            tInput.value = t.toFixed(2);
          }
          update();
          requestAnimationFrame(frame);
        }

        playBtn.addEventListener("click", function () {
          playing = !playing;
          playBtn.textContent = playing ? "Pausar" : "Reproducir";
        });

        pInput.addEventListener("input", function () {
          p = parseFloat(pInput.value);
          pValue.textContent = String(p).replace(".", ",");
          update();
        });

        tInput.addEventListener("input", function () {
          t = parseFloat(tInput.value);
          playing = false;
          playBtn.textContent = "Reproducir";
          update();
        });

        var scroll = document.getElementById("cw-scroll");
        if (scroll && scroll.scrollWidth > scroll.clientWidth) {
          scroll.scrollLeft = (scroll.scrollWidth - scroll.clientWidth) / 2;
        }

        update();
        requestAnimationFrame(frame);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</div>

<div id="tabla" class="lesson-box">
  <h2>4. Tabla, imagen y preimagen</h2>

  <h3>La tabla de valores</h3>
  <p>
    Para <span class="font-mono text-violet-400">f(x) = x²</span> armamos una
    tabla de valores y ubicamos los puntos en el plano:
  </p>

  <table>
    <thead><tr><th>x</th><th>f(x) = x²</th></tr></thead>
    <tbody>
      <tr><td>−3</td><td>9</td></tr>
      <tr><td>−2</td><td>4</td></tr>
      <tr><td>−1</td><td>1</td></tr>
      <tr><td>0</td><td>0</td></tr>
      <tr><td>1</td><td>1</td></tr>
      <tr><td>2</td><td>4</td></tr>
      <tr><td>3</td><td>9</td></tr>
    </tbody>
  </table>

  <div style="max-width:520px;margin:1.25rem auto" set:html={graphSvg({ a: 1, b: 0, c: 0, xmin: -4, xmax: 4, ymin: -1, ymax: 10, w: 460, h: 400, points: [[-3, 9], [-2, 4], [-1, 1], [0, 0], [1, 1], [2, 4], [3, 9]], roots: false, intercept: false, uid: "tabla" })}></div>

  <p>
    Los puntos de la tabla no quedan alineados: forman una <strong>curva</strong>.
    Cuanto más puntos agregamos, mejor se ve la parábola.
  </p>

  <h3>Calcular una imagen</h3>
  <p>
    Para calcular la imagen de un número, reemplazamos la <strong>x</strong> en
    la fórmula:
  </p>
  <p class="font-mono text-violet-400">f(2) = 2² = 4</p>
  <p class="font-mono text-violet-400">f(−3) = (−3)² = 9</p>
  <p class="font-mono text-violet-400">f(0) = 0² = 0</p>
  <p>Entonces, la imagen de 2 es 4 y la imagen de −3 es 9.</p>

  <h3>Calcular una preimagen</h3>
  <p>
    Para calcular la preimagen de un valor, planteamos{" "}
    <span class="font-mono text-violet-400">f(x) = valor</span> y resolvemos la
    ecuación cuadrática.
  </p>
  <p>¿Cuál es la preimagen de 4 en <span class="font-mono text-violet-400">f(x) = x²</span>?</p>
  <ol>
    <li>Planteamos: x² = 4</li>
    <li>Pasamos todo a un lado: x² − 4 = 0</li>
    <li>Factorizamos: (x − 2)(x + 2) = 0</li>
    <li>x = 2 o x = −2</li>
  </ol>
  <p>
    La imagen 4 tiene <strong>dos preimágenes</strong>: 2 y −2. En la gráfica,
    son los dos puntos de la parábola que están a la altura 4.
  </p>
  <p>¿Y la preimagen de 9?</p>
  <p class="font-mono text-violet-400">x² = 9 → x = 3 o x = −3</p>
  <p>
    En cambio, la preimagen de −1 no existe:{" "}
    <span class="font-mono text-violet-400">x² = −1</span> no tiene solución
    real, porque un cuadrado nunca es negativo.
  </p>
  <p>
    <strong>Importante:</strong> en una función cuadrática un valor puede tener{" "}
    <strong>dos, una o ninguna preimagen</strong>. Eso depende de la ecuación que
    queda al plantear f(x) = valor.
  </p>

  <h3>Otro ejemplo: f(x) = x² − 2x − 3</h3>
  <table>
    <thead><tr><th>x</th><th>f(x) = x² − 2x − 3</th></tr></thead>
    <tbody>
      <tr><td>−2</td><td>5</td></tr>
      <tr><td>−1</td><td>0</td></tr>
      <tr><td>0</td><td>−3</td></tr>
      <tr><td>1</td><td>−4</td></tr>
      <tr><td>2</td><td>−3</td></tr>
      <tr><td>3</td><td>0</td></tr>
      <tr><td>4</td><td>5</td></tr>
    </tbody>
  </table>

  <p>
    La imagen de 2 es −3:{" "}
    <span class="font-mono text-violet-400">f(2) = 2² − 2·2 − 3 = −3</span>.
  </p>
  <p>Veamos algunas preimágenes:</p>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li>
      <strong>Preimagen de 0:</strong> x² − 2x − 3 = 0 → (x − 3)(x + 1) = 0 →{" "}
      <strong>x = 3 o x = −1</strong>.
    </li>
    <li>
      <strong>Preimagen de −3:</strong> x² − 2x − 3 = −3 → x² − 2x = 0 →{" "}
      x(x − 2) = 0 → <strong>x = 0 o x = 2</strong>.
    </li>
    <li>
      <strong>Preimagen de −4:</strong> x² − 2x − 3 = −4 → x² − 2x + 1 = 0 →{" "}
      (x − 1)² = 0 → <strong>x = 1</strong> (una sola preimagen).
    </li>
    <li>
      <strong>Preimagen de 5:</strong> x² − 2x − 3 = 5 → x² − 2x − 8 = 0 →{" "}
      (x − 4)(x + 2) = 0 → <strong>x = 4 o x = −2</strong>.
    </li>
    <li>
      <strong>Preimagen de −5:</strong> x² − 2x − 3 = −5 → x² − 2x + 2 = 0.
      Al aplicar Bhaskara queda{" "}
      <span class="font-mono text-violet-400">√((−2)² − 4·1·2) = √(−4)</span>, y un
      número negativo no tiene raíz cuadrada real:{" "}
      <strong>no tiene preimagen real</strong>.
    </li>
  </ul>
</div>

<div id="raices" class="lesson-box">
  <h2>5. Raíces: los tres casos</h2>
  <p>
    Las <strong>raíces</strong> de una función cuadrática son los valores de x
    para los cuales <span class="font-mono text-violet-400">f(x) = 0</span>. En
    la gráfica, son los puntos donde la parábola <strong>corta el eje x</strong>.
  </p>
  <p>
    Para encontrarlas resolvemos{" "}
    <span class="font-mono text-violet-400">ax² + bx + c = 0</span>. Según cómo
    sea la ecuación, conviene usar un método distinto.
  </p>

  <h3>Si falta el término lineal (b = 0): despejar y aplicar raíz</h3>
  <p class="font-mono text-violet-400">x² − 9 = 0 → x² = 9 → x = ±√9</p>
  <p class="font-mono text-violet-400">x = 3 o x = −3</p>
  <p>
    El <strong>±</strong> aparece porque 3² = 9 y también (−3)² = 9. Si al
    despejar queda un número negativo, no hay solución real:
  </p>
  <p class="font-mono text-violet-400">x² = −4 → x = ±√(−4) → sin solución real</p>

  <h3>Si falta el término independiente (c = 0): factor común</h3>
  <p class="font-mono text-violet-400">x² − 3x = 0 → x(x − 3) = 0</p>
  <p class="font-mono text-violet-400">x = 0 o x − 3 = 0 → x = 0 o x = 3</p>
  <p>
    Usamos la <strong>propiedad hankeliana</strong>: un producto es cero cuando
    <strong>alguno de sus factores es cero</strong>. Por eso estas ecuaciones
    siempre tienen a x = 0 como una de sus raíces.
  </p>

  <h3>Si la ecuación está completa: Bhaskara</h3>
  <p>Cuando aparecen los tres términos, usamos la fórmula de Bhaskara:</p>
  <p class="font-mono text-violet-400" style="font-size:1.1rem">
    x = (−b ± √(b² − 4ac)) / (2a)
  </p>
  <p><strong>Ejemplo:</strong> f(x) = x² − 2x − 3 → a = 1, b = −2, c = −3</p>
  <p class="font-mono text-violet-400">
    x = (2 ± √((−2)² − 4·1·(−3))) / (2·1)
  </p>
  <p class="font-mono text-violet-400">
    x = (2 ± √(4 + 12)) / 2 = (2 ± √16) / 2 = (2 ± 4) / 2
  </p>
  <p class="font-mono text-violet-400">
    x₁ = (2 − 4)/2 = −1 &nbsp;&nbsp; x₂ = (2 + 4)/2 = 3
  </p>

  <p>
    Al resolver, pueden pasar <strong>tres cosas</strong>. Lo importante es
    mirar <strong>lo que queda dentro de la raíz</strong>:
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.25rem;margin:1.5rem 0">
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: -2, c: -3, xmin: -3, xmax: 5, ymin: -5, ymax: 4, w: 380, h: 340, uid: "r1" })}></div>
      <p style="margin:.5rem 0 0;color:#cbd5e1;font-size:.9rem"><strong style="color:#f59e0b">Dos raíces distintas:</strong> dentro de la raíz queda un número positivo.</p>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: -2, c: 1, xmin: -2, xmax: 4, ymin: -2, ymax: 5, w: 380, h: 340, uid: "r2" })}></div>
      <p style="margin:.5rem 0 0;color:#cbd5e1;font-size:.9rem"><strong style="color:#f59e0b">Una raíz doble:</strong> dentro de la raíz queda 0.</p>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: 0, c: 1, xmin: -3, xmax: 3, ymin: -1, ymax: 6, w: 380, h: 340, uid: "r3" })}></div>
      <p style="margin:.5rem 0 0;color:#cbd5e1;font-size:.9rem"><strong style="color:#f59e0b">Sin raíces reales:</strong> dentro de la raíz queda un número negativo.</p>
    </div>
  </div>

  <p>
    En los tres gráficos, el punto <strong style="color:#34d399">verde</strong>{" "}
    es la <strong>ordenada en el origen</strong>: siempre es{" "}
    <span class="font-mono text-violet-400">(0, c)</span>. Los puntos{" "}
    <strong style="color:#f59e0b">naranjas</strong> son las raíces.
  </p>

  <h3>Más ejemplos</h3>

  <p><strong>1) f(x) = x² − 5x + 6</strong> (dos raíces)</p>
  <p class="font-mono text-violet-400">a = 1, b = −5, c = 6</p>
  <p class="font-mono text-violet-400">
    x = (5 ± √((−5)² − 4·1·6)) / 2 = (5 ± √(25 − 24)) / 2 = (5 ± 1) / 2
  </p>
  <p class="font-mono text-violet-400">
    x₁ = (5 − 1)/2 = 2 &nbsp;&nbsp; x₂ = (5 + 1)/2 = 3
  </p>

  <p><strong>2) f(x) = x² − 4x + 4</strong> (una raíz doble)</p>
  <p class="font-mono text-violet-400">
    x = (4 ± √((−4)² − 4·1·4)) / 2 = (4 ± √0) / 2 = 4/2 = 2
  </p>
  <p>
    La solución es <strong>x = 2</strong>. También se puede ver como{" "}
    <span class="font-mono text-violet-400">(x − 2)² = 0</span>: la parábola
    toca el eje x en un solo punto.
  </p>

  <p><strong>3) f(x) = x² + 2x + 5</strong> (sin raíces reales)</p>
  <p class="font-mono text-violet-400">
    x = (−2 ± √(2² − 4·1·5)) / 2 = (−2 ± √(−16)) / 2
  </p>
  <p>
    Dentro de la raíz queda <strong>−16</strong>, que no tiene raíz cuadrada
    real. Entonces <strong>no hay raíces reales</strong>: la parábola no corta
    al eje x.
  </p>
  <p>
    Si <span class="font-mono text-violet-400">a &lt; 0</span> la parábola se
    abre hacia abajo, pero los métodos y la fórmula de Bhaskara se usan
    exactamente igual.
  </p>
</div>

<div id="vertice" class="lesson-box">
  <h2>6. Vértice y eje de simetría</h2>
  <p>
    El <strong>vértice</strong> es el punto más bajo o más alto de la parábola.
    Si <span class="font-mono text-violet-400">a &gt; 0</span> es un{" "}
    <strong>mínimo</strong>; si <span class="font-mono text-violet-400">a &lt; 0</span>{" "}
    es un <strong>máximo</strong>.
  </p>
  <p>
    El <strong>eje de simetría</strong> es la recta vertical que pasa por el
    vértice. La parábola es simétrica respecto de esa recta.
  </p>

  <p>Las fórmulas son:</p>
  <p class="font-mono text-violet-400" style="font-size:1.15rem">xᵥ = −b / (2a)</p>
  <p class="font-mono text-violet-400" style="font-size:1.15rem">yᵥ = f(xᵥ)</p>
  <p class="font-mono text-violet-400" style="font-size:1.15rem">eje de simetría: x = xᵥ</p>
  <p>
    Si la función tiene raíces, el vértice está justo en el punto medio entre
    ellas: <span class="font-mono text-violet-400">xᵥ = (x₁ + x₂) / 2</span>.
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin:1.5rem 0">
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: -2, c: -3, xmin: -3, xmax: 5, ymin: -6, ymax: 4, w: 400, h: 360, vertex: true, axis: true, uid: "v1" })}></div>
      <p style="margin:.5rem 0 0;color:#cbd5e1;font-size:.9rem"><strong style="color:#f472b6">a &gt; 0:</strong> el vértice es un mínimo.</p>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: -1, b: 2, c: 3, xmin: -3, xmax: 5, ymin: -3, ymax: 5, w: 400, h: 360, vertex: true, axis: true, uid: "v2" })}></div>
      <p style="margin:.5rem 0 0;color:#cbd5e1;font-size:.9rem"><strong style="color:#f472b6">a &lt; 0:</strong> el vértice es un máximo.</p>
    </div>
  </div>

  <h3>Ejemplos</h3>
  <p><strong>1) f(x) = x² − 2x − 3</strong></p>
  <p class="font-mono text-violet-400">xᵥ = −(−2) / (2·1) = 2/2 = 1</p>
  <p class="font-mono text-violet-400">yᵥ = f(1) = 1² − 2·1 − 3 = −4</p>
  <p>
    Vértice: <strong>(1, −4)</strong>. Eje de simetría:{" "}
    <strong>x = 1</strong>. Como a &gt; 0, es un mínimo.
  </p>

  <p><strong>2) f(x) = −x² + 2x + 3</strong></p>
  <p class="font-mono text-violet-400">xᵥ = −2 / (2·(−1)) = 1</p>
  <p class="font-mono text-violet-400">yᵥ = f(1) = −1² + 2·1 + 3 = 4</p>
  <p>
    Vértice: <strong>(1, 4)</strong>. Eje de simetría:{" "}
    <strong>x = 1</strong>. Como a &lt; 0, es un máximo.
  </p>

  <p><strong>3) f(x) = 2x² − 8x + 5</strong></p>
  <p class="font-mono text-violet-400">xᵥ = −(−8) / (2·2) = 8/4 = 2</p>
  <p class="font-mono text-violet-400">yᵥ = f(2) = 2·2² − 8·2 + 5 = 8 − 16 + 5 = −3</p>
  <p>Vértice: <strong>(2, −3)</strong>. Eje de simetría: <strong>x = 2</strong>.</p>
</div>

<div id="signo" class="lesson-box">
  <h2>7. Signo de las imágenes</h2>
  <p>
    El signo de las imágenes nos dice <strong>dónde está la parábola</strong>{" "}
    respecto del eje x:
  </p>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li>Si la parábola está <strong>por encima</strong> del eje x: f(x) &gt; 0.</li>
    <li>Si está <strong>por debajo</strong>: f(x) &lt; 0.</li>
    <li>Si <strong>corta</strong> el eje x: f(x) = 0 (son las raíces).</li>
  </ul>
  <p>
    El signo depende de <strong>a</strong> y de las <strong>raíces</strong>. En
    cada esquema, el <strong style="color:#f59e0b">0</strong> va arriba de cada
    raíz y los <strong>+</strong> o <strong>−</strong> en cada tramo de la recta.
    Estos son todos los casos:
  </p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1.25rem;margin:1.25rem 0">
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: -2, c: -3, xmin: -3, xmax: 5, ymin: -5, ymax: 4, w: 360, h: 300, uid: "s1" })}></div>
      <div set:html={signLine("pos-out", [-1, 3], "a &gt; 0 · dos raíces: −1 y 3")}></div>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: -1, b: 2, c: 3, xmin: -3, xmax: 5, ymin: -2, ymax: 5, w: 360, h: 300, uid: "s2" })}></div>
      <div set:html={signLine("neg-out", [-1, 3], "a &lt; 0 · dos raíces: −1 y 3")}></div>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: -2, c: 1, xmin: -2, xmax: 4, ymin: -2, ymax: 5, w: 360, h: 300, uid: "s3" })}></div>
      <div set:html={signLine("double-pos", [1], "a &gt; 0 · raíz doble: 1")}></div>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: -1, b: 2, c: -1, xmin: -2, xmax: 4, ymin: -5, ymax: 2, w: 360, h: 300, uid: "s4" })}></div>
      <div set:html={signLine("double-neg", [1], "a &lt; 0 · raíz doble: 1")}></div>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: 1, b: 0, c: 1, xmin: -3, xmax: 3, ymin: -1, ymax: 6, w: 360, h: 300, uid: "s5" })}></div>
      <div set:html={signLine("always-pos", [], "a &gt; 0 · sin raíces")}></div>
    </div>
    <div style="background:rgba(15,23,42,.45);border:1px solid #334155;border-radius:10px;padding:.75rem">
      <div set:html={graphSvg({ a: -1, b: 0, c: -1, xmin: -3, xmax: 3, ymin: -6, ymax: 1, w: 360, h: 300, uid: "s6" })}></div>
      <div set:html={signLine("always-neg", [], "a &lt; 0 · sin raíces")}></div>
    </div>
  </div>

  <h3>Cómo se arma el esquema</h3>
  <p>
    Tomemos <span class="font-mono text-violet-400">f(x) = x² − 2x − 3</span>.
    Primero encontramos las raíces:
  </p>
  <p class="font-mono text-violet-400">x² − 2x − 3 = 0 → (x − 3)(x + 1) = 0</p>
  <p class="font-mono text-violet-400">x = 3 o x = −1</p>
  <p>
    Esas dos raíces <strong>dividen la recta numérica en tres tramos</strong>.
    Probamos un valor de cada tramo:
  </p>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li><span class="font-mono text-violet-400">f(−2) = (−2)² − 2·(−2) − 3 = 5 &gt; 0</span></li>
    <li><span class="font-mono text-violet-400">f(0) = 0² − 2·0 − 3 = −3 &lt; 0</span></li>
    <li><span class="font-mono text-violet-400">f(4) = 4² − 2·4 − 3 = 5 &gt; 0</span></li>
  </ul>
  <p>Con esos signos armamos la recta:</p>
  <div set:html={signLine("pos-out", [-1, 3], "f(x) = x² − 2x − 3")}></div>
  <p style="margin-top:.75rem">
    <strong>Truco:</strong> a la derecha de la raíz más grande, el signo es
    siempre el de <strong>a</strong>. Después, al pasar por cada raíz, el signo
    cambia (si es raíz simple) o se mantiene (si es raíz doble).
  </p>

  <p>La regla general es:</p>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li>
      <strong>Con dos raíces:</strong> el signo es el de <strong>a</strong> por
      fuera de las raíces y el contrario entre ellas.
    </li>
    <li>
      <strong>Con una raíz doble:</strong> el signo es el de <strong>a</strong>{" "}
      en todo el dominio, salvo 0 en la raíz.
    </li>
    <li>
      <strong>Sin raíces:</strong> el signo es el de <strong>a</strong> siempre.
    </li>
  </ul>
</div>

<div id="resumen" class="lesson-box">
  <h2>8. Resumen</h2>
  <ul class="list-disc pl-5 marker:text-red-500">
    <li>Una función cuadrática es <span class="font-mono text-violet-400">f(x) = ax² + bx + c</span>, con a ≠ 0. Su gráfica es una parábola.</li>
    <li>Si <strong>a &gt; 0</strong> abre hacia arriba; si <strong>a &lt; 0</strong>, hacia abajo.</li>
    <li>La parábola es el lugar geométrico de los puntos que equidistan del <strong>foco</strong> y de la <strong>directriz</strong>.</li>
    <li>La <strong>imagen</strong> se calcula reemplazando x en la fórmula.</li>
    <li>La <strong>preimagen</strong> se calcula resolviendo <span class="font-mono text-violet-400">f(x) = valor</span>; puede haber dos, una o ninguna.</li>
    <li>Para las <strong>raíces</strong>: si falta b, despejá x² y aplicá raíz; si falta c, sacá factor común; si está completa, usá Bhaskara.</li>
    <li>Puede haber <strong>dos raíces</strong>, <strong>una raíz doble</strong> o <strong>ninguna raíz real</strong>, según lo que quede dentro de la raíz.</li>
    <li>La <strong>ordenada en el origen</strong> es <span class="font-mono text-violet-400">(0, c)</span>.</li>
    <li>El <strong>vértice</strong> es <span class="font-mono text-violet-400">V(−b/(2a), f(−b/(2a)))</span> y el <strong>eje de simetría</strong> es <span class="font-mono text-violet-400">x = −b/(2a)</span>.</li>
    <li>El <strong>signo</strong> de las imágenes se lee de la gráfica o se deduce con las raíces y el signo de a.</li>
  </ul>
</div>

</Leccion>
