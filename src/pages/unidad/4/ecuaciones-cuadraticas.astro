---
import Layout from '../../../layouts/Layout.astro';
import ProximamenteLeccion from '../../../components/ProximamenteLeccion.astro';

const unitId = 4;
const unitTitle = "Ecuaciones de segundo grado";
const lessonTitle = "Ecuaciones cuadráticas";
---

<Layout title={`${lessonTitle} - EBI 9C`}>
  <div class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
        <a href="/" class="hover:text-violet-400 transition-colors">Inicio</a>
        <span>/</span>
        <a href={`/unidad/${unitId}`} class="hover:text-violet-400 transition-colors">Unidad {unitId}</a>
        <span>/</span>
        <span class="text-slate-300">{lessonTitle}</span>
      </nav>

      <ProximamenteLeccion title={lessonTitle} unitId={unitId} unitTitle={unitTitle} />

      <!-- Botón de práctica -->
      <div class="practico-box mt-10">
        <h3>¿Querés practicar?</h3>
        <p>Descargá los ejercicios de ecuaciones cuadráticas (forma completa ax² + bx + c = 0).</p>
        <a href="/pdfs/4-3-ecuacion-ax2-bx-c.pdf" target="_blank" rel="noopener">
          Descargar práctico (PDF)
        </a>
      </div>
    </div>
  </div>
</Layout>
