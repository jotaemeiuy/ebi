    border-radius: 3px;
  }
  @media (max-width: 640px) {
    .formula {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
    }
    .formula-lg {
      font-size: 0.9rem;
    }
    li .katex {
      font-size: 0.88em;
    }
  }
</style>


      <!-- Botón de práctica -->
      <div class="practico-box mt-10">
