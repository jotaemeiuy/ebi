<Leccion title="Porcentajes y Porcentajes encadenados" unitId={1} unitTitle="Números y Finanzas" next="/unidad/1/notacion-cientifica" prev="/unidad/1/interes-simple" prev="/unidad/1/notacion-cientifica" next="/unidad/1/interes-simple">

