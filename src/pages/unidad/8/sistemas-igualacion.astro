---
import Leccion from "../../../layouts/Leccion.astro";
import Formula from "../../../components/Formula.astro";
---

<Leccion title="Sistemas de ecuaciones - Método de Igualación" unitId={8} unitTitle="Sistemas de Ecuaciones">

<div class="lesson-box">
  <h2>Contenido de esta lección:</h2>
  <ul>
    <li><a href="#metodo">• Método de igualación</a></li>
    <li><a href="#problemas">• Problemas resueltos</a></li>
  </ul>
</div>

<div id="metodo" class="lesson-box">
  <h2>Método de igualación</h2>
  <p>
    Consiste en despejar la <strong>misma variable</strong> en ambas ecuaciones
    y luego igualar las dos expresiones obtenidas.
  </p>
  <p><strong>Pasos:</strong></p>
  <ol>
    <li>Despejar la misma variable (<Formula tex={String.raw`x`} /> o <Formula tex={String.raw`y`} />) en ambas ecuaciones</li>
    <li>Igualar las dos expresiones</li>
    <li>Resolver la ecuación resultante</li>
    <li>Sustituir el valor obtenido en cualquiera de las expresiones para hallar la otra variable</li>
  </ol>
  <p>Ejemplo rápido:</p>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} x + y = 7 \\ x - y = 3 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`x`} /> en ambas: <Formula tex={String.raw`x = 7 - y`} /> y <Formula tex={String.raw`x = 3 + y`} /></li>
    <li>Igualamos: <Formula tex={String.raw`7 - y = 3 + y`} /></li>
    <li><Formula tex={String.raw`7 - 3 = 2y \;\to\; 4 = 2y \;\to\; y = 2`} /></li>
    <li><Formula tex={String.raw`x = 7 - 2 = 5`} /></li>
  </ol>
  <p><strong>Solución:</strong> <Formula tex={String.raw`x = 5`} />, <Formula tex={String.raw`y = 2`} /></p>
</div>

<div id="problemas" class="lesson-box">
  <h2>Problemas resueltos paso a paso</h2>

  <h3>1)</h3>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} x + y = 8 \\ x - y = 2 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`x`} />: <Formula tex={String.raw`x = 8 - y`} /> y <Formula tex={String.raw`x = 2 + y`} /></li>
    <li>Igualamos: <Formula tex={String.raw`8 - y = 2 + y`} /></li>
    <li><Formula tex={String.raw`6 = 2y \;\to\; y = 3`} /></li>
    <li><Formula tex={String.raw`x = 8 - 3 = 5`} /></li>
  </ol>
  <p class="text-violet-400"><strong>Solución:</strong> <Formula tex={String.raw`x = 5`} />, <Formula tex={String.raw`y = 3`} /></p>

  <h3>2)</h3>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} 2x + y = 10 \\ x + y = 7 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`y`} />: <Formula tex={String.raw`y = 10 - 2x`} /> y <Formula tex={String.raw`y = 7 - x`} /></li>
    <li>Igualamos: <Formula tex={String.raw`10 - 2x = 7 - x`} /></li>
    <li><Formula tex={String.raw`10 - 7 = 2x - x \;\to\; 3 = x \;\to\; x = 3`} /></li>
    <li><Formula tex={String.raw`y = 7 - 3 = 4`} /></li>
  </ol>
  <p class="text-violet-400"><strong>Solución:</strong> <Formula tex={String.raw`x = 3`} />, <Formula tex={String.raw`y = 4`} /></p>

  <h3>3)</h3>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} 3x - y = 7 \\ x + y = 5 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`y`} />: <Formula tex={String.raw`y = 3x - 7`} /> y <Formula tex={String.raw`y = 5 - x`} /></li>
    <li>Igualamos: <Formula tex={String.raw`3x - 7 = 5 - x`} /></li>
    <li><Formula tex={String.raw`4x = 12 \;\to\; x = 3`} /></li>
    <li><Formula tex={String.raw`y = 5 - 3 = 2`} /></li>
  </ol>
  <p class="text-violet-400"><strong>Solución:</strong> <Formula tex={String.raw`x = 3`} />, <Formula tex={String.raw`y = 2`} /></p>

  <h3>4)</h3>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} x + 2y = 11 \\ 3x - 2y = 1 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`x`} />: <Formula tex={String.raw`x = 11 - 2y`} /> y <Formula tex={String.raw`\displaystyle x = \frac{1 + 2y}{3}`} /></li>
    <li>Igualamos: <Formula tex={String.raw`\displaystyle 11 - 2y = \frac{1 + 2y}{3}`} /></li>
    <li>Multiplicamos por 3: <Formula tex={String.raw`33 - 6y = 1 + 2y`} /></li>
    <li><Formula tex={String.raw`32 = 8y \;\to\; y = 4`} /></li>
    <li><Formula tex={String.raw`x = 11 - 2(4) = 3`} /></li>
  </ol>
  <p class="text-violet-400"><strong>Solución:</strong> <Formula tex={String.raw`x = 3`} />, <Formula tex={String.raw`y = 4`} /></p>

  <h3>5)</h3>
  <div class="formula">
    <Formula display tex={String.raw`\begin{cases} 2x + 3y = 13 \\ 4x - y = 5 \end{cases}`} />
  </div>
  <ol>
    <li>Despejamos <Formula tex={String.raw`y`} />: <Formula tex={String.raw`\displaystyle y = \frac{13 - 2x}{3}`} /> y <Formula tex={String.raw`y = 4x - 5`} /></li>
    <li>Igualamos: <Formula tex={String.raw`\displaystyle \frac{13 - 2x}{3} = 4x - 5`} /></li>
    <li>Multiplicamos por 3: <Formula tex={String.raw`13 - 2x = 12x - 15`} /></li>
    <li><Formula tex={String.raw`28 = 14x \;\to\; x = 2`} /></li>
    <li><Formula tex={String.raw`y = 4(2) - 5 = 3`} /></li>
  </ol>
  <p class="text-violet-400"><strong>Solución:</strong> <Formula tex={String.raw`x = 2`} />, <Formula tex={String.raw`y = 3`} /></p>
</div>

<style is:global>
  .formula {
    color: #c4b5fd;
    font-size: 1.05rem;
    background: rgba(2, 6, 23, 0.6);
    border-left: 3px solid #7c3aed;
    border-radius: 6px;
    padding: 0.35rem 0.9rem;
    margin: 0.55rem 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .formula .katex-display {
    margin: 0.25em 0;
  }
  .formula-lg {
    font-size: 1.22rem;
    padding: 0.55rem 0.9rem;
    margin: 0.8rem 0;
  }
  .formula::-webkit-scrollbar {
    height: 6px;
  }
  .formula::-webkit-scrollbar-thumb {
    background: #475569;
    border-radius: 3px;
  }
  @media (max-width: 640px) {
    .formula {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
    }
    .formula-lg {
      font-size: 0.9rem;
    }
    li .katex {
      font-size: 0.88em;
    }
  }
</style>

</Leccion>
