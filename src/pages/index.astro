---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import UnitCard from "../components/UnitCard.astro";

const units = [
	{
		id: 1,
		title: "Números y Finanzas",
		subtitle: "Notación científica, porcentajes e interés",
		topics: [
			"Notación científica",
			"Porcentajes",
			"Interés simple",
			"Interés compuesto",
		],
		icon: "💰",
	},
	{
		id: 2,
		title: "Álgebra",
		subtitle: "Expresiones algebraicas y factorización",
		topics: ["Propiedad distributiva", "Productos notables", "Factorización"],
		icon: "📐",
	},
	{
		id: 3,
		title: "Ecuaciones de primer grado",
		subtitle: "Igualdad, transposición de términos y método general",
		topics: [
			"Igualdad algebraica",
			"Identidad y ecuación",
			"Ecuaciones equivalentes",
			"Transposición de términos",
			"Método general de resolución",
		],
		icon: "⚖️",
	},
	{
		id: 4,
		title: "Ecuaciones de segundo grado",
		subtitle: "Ecuaciones cuadráticas y fórmula de Bhaskara",
		topics: ["ax² + c = 0", "ax² + bx = 0", "ax² + bx + c = 0"],
		icon: "🧮",
	},
	{
		id: 5,
		title: "Trigonometría",
		subtitle: "Triángulos rectángulos: Pitágoras, seno, coseno y tangente",
		topics: ["Teorema de Pitágoras", "Seno, coseno y tangente", "Resolución de triángulos"],
		icon: "📐",
	},
	{
		id: 6,
		title: "Función lineal",
		subtitle: "Ecuación de la recta, pendiente y gráfica",
		topics: ["Pendiente", "Ordenada al origen", "Representación gráfica"],
		icon: "📈",
	},
	{
		id: 7,
		title: "Función cuadrática",
		subtitle: "Parábola, vértice y representación gráfica",
		topics: ["Parábola", "Vértice y eje de simetría", "Gráfica"],
		icon: "📉",
	},
	{
		id: 8,
		title: "Sistemas de Ecuaciones",
		subtitle: "Sistemas de ecuaciones lineales 2×2",
		topics: ["Sustitución", "Igualación", "Reducción", "Método gráfico"],
		icon: "🔗",
	},
];
---

<Layout>
	<Hero />

	<!-- Banner APE -->
	<section class="pb-2">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<a
				href="/ape"
				class="group flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-2xl border border-violet-500/40 bg-linear-to-r from-violet-900/30 to-slate-900/60 p-6 transition-all hover:border-violet-400"
			>
				<div
					class="w-12 h-12 shrink-0 rounded-xl bg-violet-500/20 flex items-center justify-center text-2xl"
				>
					📣
				</div>
				<div class="flex-1">
					<h2 class="text-lg font-semibold text-slate-100 group-hover:text-violet-300 transition-colors">
						Período APE — Prácticos de nivelación
					</h2>
					<p class="text-slate-400 text-sm">
						4 clases para levantar la nota. Ejercicios de todos los temas del año, listos para descargar.
					</p>
				</div>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-6 h-6 shrink-0 text-violet-400 group-hover:translate-x-1 transition-transform"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 5l7 7-7 7"
					/>
				</svg>
			</a>
		</div>
	</section>

	<section id="unidades" class="py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-slate-100 mb-4">
					Unidades de Trabajo
				</h2>
				<p class="text-slate-400 max-w-2xl mx-auto">
					Seleccioná una unidad para acceder a las lecciones,
					ejercicios y materiales.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					units.map((unit) => (
						<UnitCard
							id={unit.id}
							title={unit.title}
							subtitle={unit.subtitle}
							topics={unit.topics}
							icon={unit.icon}
						/>
					))
				}
			</div>
		</div>
	</section>
</Layout>
