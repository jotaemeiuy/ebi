---
interface Linea {
  /** Pendiente */
  a: number;
  /** Ordenada en el origen */
  b: number;
  color?: string;
  /** Patrón de guiones, por ejemplo "7 5" */
  dash?: string;
}

interface Punto {
  x: number;
  y: number;
  label?: string;
  color?: string;
  /** Desplazamiento de la etiqueta respecto al punto */
  dx?: number;
  dy?: number;
  ancla?: "start" | "middle" | "end";
}

interface Props {
  lineas: Linea[];
  puntos?: Punto[];
  xmin?: number;
  xmax?: number;
  ymin?: number;
  ymax?: number;
  ancho?: number;
  alto?: number;
  ariaLabel?: string;
}

const {
  lineas,
  puntos = [],
  xmin = -1,
  xmax = 5,
  ymin = -1,
  ymax = 5,
  ancho = 380,
  alto = 320,
  ariaLabel = "Gráfica de rectas en el plano cartesiano",
} = Astro.props;

const pad = 28;
const w = ancho - 2 * pad;
const h = alto - 2 * pad;

const sx = (x: number) => pad + ((x - xmin) / (xmax - xmin)) * w;
const sy = (y: number) => alto - pad - ((y - ymin) / (ymax - ymin)) * h;

const enterosX: number[] = [];
for (let x = Math.ceil(xmin); x <= Math.floor(xmax); x++) enterosX.push(x);
const enterosY: number[] = [];
for (let y = Math.ceil(ymin); y <= Math.floor(ymax); y++) enterosY.push(y);

const ejeX = ymin <= 0 && ymax >= 0;
const ejeY = xmin <= 0 && xmax >= 0;

const segmentos = lineas.map((l) => ({
  x1: sx(xmin),
  y1: sy(l.a * xmin + l.b),
  x2: sx(xmax),
  y2: sy(l.a * xmax + l.b),
  color: l.color ?? "#a78bfa",
  dash: l.dash,
}));

// Rectas en coordenadas de pantalla, para medir distancias
const rectasPx = lineas.map((l) => {
  const x1 = sx(xmin);
  const y1 = sy(l.a * xmin + l.b);
  const x2 = sx(xmax);
  const y2 = sy(l.a * xmax + l.b);
  return { x1, y1, x2, y2 };
});

function distanciaARecta(px: number, py: number, r: { x1: number; y1: number; x2: number; y2: number }) {
  const A = r.y2 - r.y1;
  const B = r.x1 - r.x2;
  const C = r.x2 * r.y1 - r.x1 * r.y2;
  const den = Math.hypot(A, B);
  return den === 0 ? Infinity : Math.abs(A * px + B * py + C) / den;
}

const RADIO = 26;
const direcciones = [
  { dx: 1, dy: 0 },
  { dx: -1, dy: 0 },
  { dx: 0, dy: -1 },
  { dx: 0, dy: 1 },
  { dx: 0.707, dy: -0.707 },
  { dx: -0.707, dy: -0.707 },
  { dx: 0.707, dy: 0.707 },
  { dx: -0.707, dy: 0.707 },
];

// Elige la posición de la etiqueta más lejos de las rectas, sin salir del gráfico
function ubicarEtiqueta(cx: number, cy: number, texto: string) {
  const anchoTexto = texto.length * 7.5;
  let mejor = { lx: cx + 9, ly: cy - 9, ancla: "start" as const };
  let mejorPuntaje = -Infinity;

  for (const d of direcciones) {
    const lx = cx + d.dx * RADIO;
    const ly = cy + d.dy * RADIO + 4;
    const ancla = d.dx > 0.3 ? "start" : d.dx < -0.3 ? "end" : "middle";

    // Fuera del área de dibujo
    const margenIzq = ancla === "start" ? lx : ancla === "end" ? lx - anchoTexto : lx - anchoTexto / 2;
    const margenDer = margenIzq + anchoTexto;
    const dentro =
      margenIzq >= pad + 2 &&
      margenDer <= ancho - pad - 2 &&
      ly >= pad + 10 &&
      ly <= alto - pad - 2;

    const distancia = rectasPx.length
      ? Math.min(...rectasPx.map((r) => distanciaARecta(lx, ly, r)))
      : Infinity;

    const puntaje = distancia + (dentro ? 0 : -60);
    if (puntaje > mejorPuntaje) {
      mejorPuntaje = puntaje;
      mejor = { lx, ly, ancla };
    }
  }
  return mejor;
}

const marcas = puntos.map((p) => {
  const cx = sx(p.x);
  const cy = sy(p.y);
  const auto = p.label ? ubicarEtiqueta(cx, cy, p.label) : null;
  return {
    cx,
    cy,
    label: p.label,
    color: p.color ?? "#f59e0b",
    lx: p.dx !== undefined ? cx + p.dx : auto ? auto.lx : cx + 9,
    ly: p.dy !== undefined ? cy + p.dy : auto ? auto.ly : cy - 9,
    ancla: p.ancla ?? auto?.ancla ?? "start",
  };
});

---

<svg
  viewBox={`0 0 ${ancho} ${alto}`}
  role="img"
  aria-label={ariaLabel}
  style="display:block;width:100%;height:auto;background:#0b1120;border-radius:10px"
>
  <g stroke="#1e293b" stroke-width="1">
    {enterosX.map((x) => (
      <line x1={sx(x)} y1={pad} x2={sx(x)} y2={alto - pad} />
    ))}
    {enterosY.map((y) => (
      <line x1={pad} y1={sy(y)} x2={ancho - pad} y2={sy(y)} />
    ))}
  </g>

  <g stroke="#64748b" stroke-width="1.5">
    {ejeX && <line x1={pad - 8} y1={sy(0)} x2={ancho - pad + 8} y2={sy(0)} />}
    {ejeY && <line x1={sx(0)} y1={alto - pad + 8} x2={sx(0)} y2={pad - 8} />}
  </g>

  <g fill="#94a3b8" font-size="11" text-anchor="middle">
    {ejeX && enterosX.filter((x) => x !== 0).map((x) => (
      <text x={sx(x)} y={sy(0) + 16}>{x}</text>
    ))}
  </g>
  <g fill="#94a3b8" font-size="11" text-anchor="end">
    {ejeY && enterosY.filter((y) => y !== 0).map((y) => (
      <text x={sx(0) - 6} y={sy(y) + 4}>{y}</text>
    ))}
  </g>

  <g fill="none" stroke-width="2.6" stroke-linecap="round">
    {segmentos.map((s) => (
      <line
        x1={s.x1}
        y1={s.y1}
        x2={s.x2}
        y2={s.y2}
        stroke={s.color}
        stroke-dasharray={s.dash}
      />
    ))}
  </g>

  <g>
    {marcas.map((m) => (
      <g>
        <circle cx={m.cx} cy={m.cy} r="5" fill={m.color} />
        {m.label && (
          <text
            x={m.lx}
            y={m.ly}
            fill={m.color}
            font-size="13"
            font-weight="600"
            text-anchor={m.ancla}
            paint-order="stroke"
            stroke="#0b1120"
            stroke-width="3.5"
            stroke-linejoin="round"
          >
            {m.label}
          </text>
        )}
      </g>
    ))}
  </g>
</svg>
