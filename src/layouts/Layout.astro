---
import "../styles/global.css";
import "katex/dist/katex.min.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "EBI - UTU Arroyo Seco",
	description = "Material de matemática para 9°C",
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-slate-950 text-slate-100 font-sans antialiased">
		<nav
			class="sticky top-0 z-50 backdrop-blur-lg bg-slate-950/80 border-b border-slate-800"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16">
					<a
						href="/"
						class="flex items-center gap-2 font-bold text-xl"
					>
						<span class="text-violet-400">EBI Arroyo Seco</span>
						<span class="text-slate-100">9°</span>
					</a>
					<div
						class="hidden sm:flex items-center gap-6 text-sm font-medium"
					>
						<a
							href="/"
							class="text-slate-300 hover:text-violet-400 transition-colors"
							>Inicio</a
						>
						<a
							href="/#unidades"
							class="text-slate-300 hover:text-violet-400 transition-colors"
							>Unidades</a
						>
					</div>
					<a
						href="/notas"
						class="inline-flex items-center gap-2 rounded-lg border border-violet-500/30 bg-violet-500/10 px-3 py-2 text-sm font-medium text-violet-300 transition-colors hover:border-violet-400 hover:text-violet-200"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="w-4 h-4"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
							></path>
						</svg>
						Notas
					</a>
				</div>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer class="border-t border-slate-800 bg-slate-950 py-8 mt-20">
			<div
				class="max-w-7xl mx-auto px-4 text-center text-slate-400 text-sm"
			>
				<p>EBI - Matemática | UTU Arroyo Seco</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	html {
		font-family: "Inter", system-ui, sans-serif;
	}
</style>
